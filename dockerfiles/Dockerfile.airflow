FROM apache/airflow:3.0.6

# Copy requirements file into the container
COPY ./dockerfiles/requirements_airflow.txt /tmp/requirements_airflow.txt

# Install system dependencies (requires root privileges)
USER root
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    gosu \
    gcc \
    python3-dev \
    curl \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Switch back to airflow user for security
USER airflow

# Upgrade pip and install Python dependencies
RUN pip install --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r /tmp/requirements_airflow.txt && \
    pip cache purge

# Verify JWT authentication backend is available (built into Airflow 3.0 core)
RUN python -c "from airflow.api.auth.backend import jwt; print('✓ JWT auth backend is available')" || \
    echo "⚠️ WARNING: JWT auth backend not found - this may cause issues with REST API!"

# Verify Airflow version
RUN airflow version

# Copy DAGs, configuration, and plugins
COPY ./dags /opt/airflow/dags
COPY ./config /opt/airflow/config
COPY ./plugins /opt/airflow/plugins

# Create necessary directories with proper permissions
USER root
RUN mkdir -p /opt/airflow/logs /opt/airflow/data /opt/airflow/dags /opt/airflow/plugins && \
    chown -R airflow:airflow /opt/airflow
USER airflow

# Verify directory structure
RUN ls -la /opt/airflow/