FROM apache/airflow:3.0.6

# Copy requirements
COPY ./dockerfiles/requirements_airflow.txt /tmp/requirements_airflow.txt

# Install system dependencies (only what's needed)
USER root
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    gcc \
    python3-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

USER airflow

# Install Python dependencies
RUN pip install --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r /tmp/requirements_airflow.txt

# Copy project files
COPY --chown=airflow:root ./dags /opt/airflow/dags
COPY --chown=airflow:root ./config /opt/airflow/config
COPY --chown=airflow:root ./plugins /opt/airflow/plugins

# Create necessary directories
USER root
RUN mkdir -p /opt/airflow/logs /opt/airflow/data && \
    chown -R airflow:root /opt/airflow
USER airflow