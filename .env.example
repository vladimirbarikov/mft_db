# =========== AIRFLOW CONFIGURATION ===========
airflow_version=3.0.6
# Generate using the command: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=your_generated_fernet_key_here
AIRFLOW_IMAGE_NAME=mft-airflow:3.0.6
AIRFLOW_UID=1000
AIRFLOW_GID=1000
AIRFLOW_DB=airflow
AIRFLOW_USER=admin  # change in production
AIRFLOW_PASSWORD=airflow  # change in production
AIRFLOW_PROJ_DIR=.
AIRFLOW_API_URL=http://airflow-apiserver:8080
DAG_ID=mft_etl_pipeline
AIRFLOW__CORE__DAG_PROCESSOR_MANAGER_SLEEP_TIME=30
AIRFLOW__CORE__DAG_FILE_PROCESSOR_TIMEOUT=50
AIRFLOW__CORE__MIN_FILE_PROCESS_INTERVAL=30
AIRFLOW__CORE__DAG_PROCESSOR_SLEEP_TIME=10
AIRFLOW__SCHEDULER__DAG_PROCESSOR_SLEEP_TIME=10
AIRFLOW__SCHEDULER__MIN_FILE_PROCESS_INTERVAL=30

# =========== REDIS ===========
REDIS_PASSWORD=redis_password  # change in production

# =========== DATABASE CONNECTION ===========
DB_HOST=db
DB_PORT=5432
DB_NAME=mft_db
DB_USER=mft_user  # change in production
DB_PASSWORD=mft_password  # change in production
DB_MAX_RETRIES=5
DB_RETRY_DELAY=2

# =========== FLASK ===========
# Generate using the command: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your_generated_flask_secret_key_here
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
MFT_UPLOAD_API_PORT=5002
MFT_DISPLAY_API_PORT=5003
FLASK_DEBUG=false
FLASK_ENV=development  # change to "production" in production
RATE_LIMIT=10
RATE_LIMIT_STORAGE_URL=memory://

# ========== CORS CONFIGURATION ==========
# SECURITY WARNING: Do NOT use "*" in production!
# IMPORTANT: For production, replace "*" with actual domains
# Example: https://app.company.com,https://admin.company.com,http://localhost:3000
ALLOWED_ORIGINS="*"

# =========== FILE UPLOAD SETTINGS ===========
MAX_FILE_SIZE_MB=10
FILE_RETENTION_DAYS=1
TEMP_RETENTION_HOURS=1
FIXED_SHEET_NAME=mft
IGNORE_OTHER_SHEETS=true
MAX_EXCEL_ROWS=1000000
MAX_EXCEL_COLS=1000
ALLOWED_EXCEL_EXTENSIONS=.xlsx,.xls

# =========== PYTHONPATH ===========
PYTHONPATH=/app

# =========== GRAFANA ===========
GRAFANA_ADMIN_USER=admin  # change in production
GRAFANA_ADMIN_PASSWORD=grafana  # change in production

# =========== CLAMAV ===========
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# =========== ADMIN KEYS ===========
# Generate using the command: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=your_generated_admin_key_here
CLEANUP_KEY=