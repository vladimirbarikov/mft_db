# =========== AIRFLOW CONFIGURATION ===========
airflow_version=2.9.3
# Generate using the command: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=your_generated_fernet_key_here
AIRFLOW_IMAGE_NAME=mft-airflow:2.9.3
AIRFLOW_UID=
AIRFLOW_GID=
AIRFLOW_DB=
AIRFLOW_USER=
AIRFLOW_PASSWORD=
AIRFLOW_PROJ_DIR=.
AIRFLOW_API_URL=http://airflow-webserver:8080/api/v1
DAG_ID=

# =========== DATABASE CONNECTION ===========
DB_HOST=db
DB_PORT=5432
DB_NAME=mft_db
DB_USER=
DB_PASSWORD=
DB_MAX_RETRIES=5
DB_RETRY_DELAY=2

# =========== FLASK/UPLOAD API ===========
# Generate using the command: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your_generated_flask_secret_key_here
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
FLASK_ENV=  #development or production
RATE_LIMIT=
RATE_LIMIT_STORAGE_URL=

# ========== CORS CONFIGURATION ==========
# SECURITY WARNING: Do NOT use "*" in production!
# IMPORTANT: For production, replace "*" with actual domains
# Example: https://app.company.com,https://admin.company.com,http://localhost:3000
ALLOWED_ORIGINS="*"

# =========== FILE UPLOAD SETTINGS ===========
MAX_FILE_SIZE_MB=
FILE_RETENTION_DAYS=
TEMP_RETENTION_HOURS=
FIXED_SHEET_NAME=
IGNORE_OTHER_SHEETS=
MAX_EXCEL_ROWS=
MAX_EXCEL_COLS=
ALLOWED_EXCEL_EXTENSIONS=

# =========== PYTHONPATH ===========
PYTHONPATH=

# =========== GRAFANA ===========
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# =========== CLAMAV ===========
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# =========== ADMIN KEYS ===========
ADMIN_API_KEY=
CLEANUP_KEY=