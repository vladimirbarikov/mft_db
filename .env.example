# ============================================
# AIRFLOW 3.0.6 CONFIGURATION
# ============================================

# Airflow Version
airflow_version=3.0.6

# =========== AIRFLOW CORE ===========
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=your_generated_fernet_key_here

# =========== AIRFLOW 3.0 API AUTHENTICATION ===========
AIRFLOW__API__AUTH_BACKENDS=airflow.api.auth.backend.jwt

# =========== AIRFLOW 3.0 API CONFIGURATION ===========
AIRFLOW__API__EXECUTION_API_SERVER_URL=http://airflow-apiserver:8080/execution/

# JWT Secret (REQUIRED for Airflow 3.0 REST API v2)
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__API_AUTH__JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT Algorithm and Expiration
AIRFLOW__API_AUTH__JWT_ALGORITHM=HS256
AIRFLOW__API_AUTH__JWT_EXPIRATION_TIME=3600

# Docker Image
AIRFLOW_IMAGE_NAME=mft-airflow:3.0.6

# User Permissions (use 50000 for official Airflow image)
AIRFLOW_UID=50000
AIRFLOW_GID=0

# Database
AIRFLOW_DB=airflow
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=airflow

# Project Directory
AIRFLOW_PROJ_DIR=.

# DAG Configuration
DAG_ID=mft_etl_pipeline

# =========== AIRFLOW 3.0 PERFORMANCE TUNING ===========
AIRFLOW__CORE__DAG_PROCESSOR_MANAGER_SLEEP_TIME=30
AIRFLOW__CORE__DAG_FILE_PROCESSOR_TIMEOUT=50
AIRFLOW__CORE__MIN_FILE_PROCESS_INTERVAL=30
AIRFLOW__CORE__DAG_PROCESSOR_SLEEP_TIME=10
AIRFLOW__SCHEDULER__DAG_PROCESSOR_SLEEP_TIME=10
AIRFLOW__SCHEDULER__MIN_FILE_PROCESS_INTERVAL=30

# =========== AIRFLOW 3.0 TRIGGERER ===========
AIRFLOW__TRIGGERER__DEFAULT_TRIGGER_TIMEOUT=3600
AIRFLOW__TRIGGERER__MAX_TRIGGER_TIMEOUT=86400

# ============================================
# REDIS (Celery Broker)
# ============================================
REDIS_PASSWORD=redis_password

# ============================================
# DATABASE CONNECTIONS
# ============================================

# Main MFT Database
DB_HOST=db
DB_PORT=5432
DB_NAME=mft_db
DB_USER=mft_user
DB_PASSWORD=mft_password
DB_MAX_RETRIES=5
DB_RETRY_DELAY=2

# ============================================
# FLASK API CONFIGURATION
# ============================================

# Flask Secret Key
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your_generated_flask_secret_key_here

# Flask Server Settings
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
MFT_UPLOAD_API_PORT=5002
MFT_DISPLAY_API_PORT=5003
FLASK_DEBUG=false
FLASK_ENV=development

# Airflow API URL for Flask apps
AIRFLOW_API_URL=http://airflow-apiserver:8080

# =========== RATE LIMITING ===========
# Format: "X per minute/hour/day"
RATE_LIMIT=10 per minute
RATE_LIMIT_STORAGE_URL=memory://

# =========== CORS CONFIGURATION ===========
# ⚠️ SECURITY WARNING: Do NOT use "*" in production!
# For production, use comma-separated list of domains:
# Example: https://app.company.com,https://admin.company.com
ALLOWED_ORIGINS="*"

# ============================================
# FILE UPLOAD SETTINGS
# ============================================

MAX_FILE_SIZE_MB=10
FILE_RETENTION_DAYS=1
TEMP_RETENTION_HOURS=1

# =========== EXCEL VALIDATION ===========
FIXED_SHEET_NAME=mft
IGNORE_OTHER_SHEETS=true
MAX_EXCEL_ROWS=1000000
MAX_EXCEL_COLS=1000
ALLOWED_EXCEL_EXTENSIONS=.xlsx,.xls

# ============================================
# PYTHON PATH
# ============================================
PYTHONPATH=/app

# ============================================
# MONITORING & OBSERVABILITY
# ============================================

# =========== GRAFANA ===========
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana

# =========== CLAMAV ===========
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ============================================
# ADMIN & SECURITY
# ============================================

# Admin API Key
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_API_KEY=your_generated_admin_key_here

# Cleanup Key
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
CLEANUP_KEY=your_generated_cleanup_key_here

# ============================================
# ENVIRONMENT
# ============================================
ENVIRONMENT=development