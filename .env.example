# =========== AIRFLOW CONFIGURATION ===========
airflow_version=2.9.3
AIRFLOW_IMAGE_NAME=mft-airflow:2.9.3
AIRFLOW_UID=
AIRFLOW_GID=
AIRFLOW_DB=
AIRFLOW_USER=
AIRFLOW_PASSWORD=
AIRFLOW_PROJ_DIR=.
AIRFLOW_API_URL=http://airflow-webserver:8080/api/v1
DAG_ID=

# =========== DATABASE CONNECTION ===========
DB_HOST=db
DB_PORT=5432
DB_NAME=mft_db
DB_USER=
DB_PASSWORD=
DB_MAX_RETRIES=5
DB_RETRY_DELAY=2

# =========== FLASK/UPLOAD API ===========
FLASK_SECRET_KEY=
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
FLASK_ENV=  #development or production

# =========== FILE UPLOAD SETTINGS ===========
MAX_FILE_SIZE_MB=5
FILE_RETENTION_DAYS=1

# =========== PYTHONPATH ===========
PYTHONPATH=

# =========== GRAFANA ===========
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# =========== CLAMAV ===========
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
MAX_FILE_SIZE_MB=5
TEMP_RETENTION_HOURS=1